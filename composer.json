{
    "name": "zerifas/calcine",
    "description": "A baked blog generator.",
    "version": "2.0.0-dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Mat Gadd",
            "email": "mat@zerifas.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Calcine\\": "src/Calcine"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calcine\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    },
    "require": {
        "bramus/ansi-php": "~3.0",
        "twig/twig": "^3.18",
        "twig/markdown-extra": "^3.18",
        "league/commonmark": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4.1",
        "squizlabs/php_codesniffer": "^3.10.3"
    },
    "scripts": {
        "test": "XDEBUG_MODE=coverage phpunit",
        "lint": "phpcs --standard=PSR2 src/ tests/",
        "lint-checkstyle": "phpcs --standard=PSR2 --report=checkstyle -q src/ tests/"
    }
}
